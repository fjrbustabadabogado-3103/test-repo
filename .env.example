# --- General ---
NODE_ENV=development
PORT=3000
# URL pública con la que los clientes acceden (enlaces de WhatsApp, Stripe, etc.)
BASE_URL=http://localhost:3000
# Token para el panel /admin (obligatorio en producción; usa una cadena larga y aleatoria)
ADMIN_TOKEN=
# Secreto para firmar los códigos OTP (obligatorio en producción)
APP_SECRET=
DB_PATH=./data/crm.sqlite

# --- Meta (formularios Lead Ads + API de Conversiones) ---
META_GRAPH_VERSION=v21.0
# Token que tú eliges y pegas en la configuración del webhook de la app de Meta
META_VERIFY_TOKEN=
# "Clave secreta de la app" (para verificar la firma X-Hub-Signature-256)
META_APP_SECRET=
# Token de acceso de página/sistema con permiso leads_retrieval
META_ACCESS_TOKEN=
# ID del conjunto de datos (dataset / píxel) para la API de Conversiones
META_DATASET_ID=
# Opcional: código de prueba del Administrador de eventos
META_TEST_EVENT_CODE=

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Teléfono(s) del equipo que reciben los avisos de leads calientes, separados por comas (formato 34600111222)
EQUIPO_WHATSAPP=

# --- Correo (Resend). Sin clave, los correos se guardan en la bandeja de salida (modo consola) ---
RESEND_API_KEY=
EMAIL_FROM=Bustabad Abogados <hola@example.com>
EQUIPO_EMAIL=

# --- Pagos: "simulado" (desarrollo) o "stripe" ---
PAGOS_PROVEEDOR=simulado
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Documentos de los clientes (módulo 4) ---
# Carpeta donde se guardan cifrados (AES-256-GCM). Hacer copia de seguridad junto con la base de datos.
ARCHIVOS_DIR=./data/archivos
# Clave de cifrado: genera una con `openssl rand -base64 32` y guárdala a salvo: sin ella no se pueden leer los documentos.
ARCHIVOS_CLAVE=
