# Configuración de producción. Cree deploy/.env con ./crear-env.sh (genera las claves) y complete el resto.
# Este archivo contiene secretos: no lo suba nunca al repositorio ni lo envíe por correo.

# --- Dirección pública (el DNS del dominio debe apuntar ya a este servidor) ---
DOMINIO=segundaoportunidad.example.es
# Correo para los avisos del certificado HTTPS (Let's Encrypt). Obligatorio.
EMAIL_CERTIFICADOS=

# --- Claves (las genera crear-env.sh; guárdelas también en un gestor de contraseñas) ---
ADMIN_TOKEN=__GENERAR__
APP_SECRET=__GENERAR__
# Cifra los documentos de los clientes y las copias de seguridad. Si se pierde, NO se pueden recuperar.
ARCHIVOS_CLAVE=__GENERAR__

# --- Mensajería (al menos uno de los dos canales) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_IDIOMA=es
RESEND_API_KEY=
EMAIL_FROM=Bustabad Abogados <hola@example.com>

# --- Avisos al equipo (al menos uno; varios separados por comas) ---
EQUIPO_WHATSAPP=
EQUIPO_EMAIL=

# --- Pagos ---
PAGOS_PROVEEDOR=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Meta (formularios instantáneos y API de Conversiones) ---
META_GRAPH_VERSION=v21.0
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_DATASET_ID=
META_TEST_EVENT_CODE=

# --- Extracción con IA (opcional; requiere contrato de encargado del tratamiento) ---
IA_EXTRACCION=
ANTHROPIC_API_KEY=
COSTE_PREVISTO_PROCEDIMIENTO=

# --- Copias de seguridad (activas siempre en producción) ---
COPIAS_HORA=03:00
COPIAS_RETENCION_DIAS=30
